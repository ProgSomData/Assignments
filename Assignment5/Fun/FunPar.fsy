%{
 (* File Fun/FunPar.fsy 
    Parser for micro-ML, a small functional language; one-argument functions.
    sestoft@itu.dk * 2009-10-19
  *)

 open Absyn;
%}

%token <int> CSTINT
%token <string> NAME
%token <bool> CSTBOOL

%token ELSE END FALSE IF IN LET NOT THEN TRUE
%token PLUS MINUS TIMES DIV MOD
%token EQ NE GT LT GE LE AND OR          //Exercise 4.5: added AND OR
%token LPAR RPAR 
%token EOF
%token FUN ARROW //Exercise 6.3: lambda arrow added

%left ELSE              /* lowest precedence  */
%left OR                //Exercise 4.5: added AND OR
%left AND               //Exercise 4.5: added AND OR
%left EQ NE 
%left GT LT GE LE
%left PLUS MINUS
%left TIMES DIV MOD 
%nonassoc NOT           /* highest precedence  */

%start Main
%type <Absyn.expr> Main Expr AtExpr Const
%type <Absyn.expr> AppExpr
//Exercise 4.4
//Added  
%type <string list> Param
%type <Absyn.expr list> Args

%%

Main:
    Expr EOF                            { $1 }
;

Expr:
    AtExpr                              { $1                     }
  | AppExpr                             { $1                     }
  | IF Expr THEN Expr ELSE Expr         { If($2, $4, $6)         }
  | MINUS Expr                          { Prim("-", CstI 0, $2)  }
  | Expr PLUS  Expr                     { Prim("+",  $1, $3)     }
  | Expr MINUS Expr                     { Prim("-",  $1, $3)     }
  | Expr TIMES Expr                     { Prim("*",  $1, $3)     }
  | Expr DIV   Expr                     { Prim("/",  $1, $3)     } 
  | Expr MOD   Expr                     { Prim("%",  $1, $3)     }
  | Expr EQ    Expr                     { Prim("=",  $1, $3)     }
  | Expr NE    Expr                     { Prim("<>", $1, $3)     }
  | Expr GT    Expr                     { Prim(">",  $1, $3)     }
  | Expr LT    Expr                     { Prim("<",  $1, $3)     }
  | Expr GE    Expr                     { Prim(">=", $1, $3)     }
  | Expr LE    Expr                     { Prim("<=", $1, $3)     }
  | Expr AND   Expr                     { If($1, $3, CstB false) }    //Exercise 4.5: added AND OR
  | Expr OR    Expr                     { If($1, CstB true, $3)  }    //Exercise 4.5: added AND OR

;

AtExpr:
    Const                               { $1                     }
  | NAME                                { Var $1                 }
  | LET NAME EQ Expr IN Expr END        { Let($2, $4, $6)        }
  | LET NAME Param EQ Expr IN Expr END  { Letfun($2, $3, $5, $7) }    //Exercise 4.4: added param so letFun takes in list of parameters instead of one.
  | LPAR Expr RPAR                      { $2                     }
  | FUN NAME ARROW Expr                 { Fun($2, $4)            }    //Exercise 6.3: added lambda rule
;

AppExpr:
    AtExpr Args                         { Call($1, $2)           }
  //| AppExpr Args                        { Call($1, $2)           }  //Exercise 4.4: rule is superfluous since we dont need to use call recursively with one argument at a time anymore
;

Const:
    CSTINT                              { CstI($1)               }
  | CSTBOOL                             { CstB($1)               }
;

//Exercise 4.4
//we add 
Param:
    NAME                                  { [$1]                    }
  | NAME Param                            { $1 :: $2                }
;

Args:
    AtExpr                                { [$1]                    }
  | AtExpr Args                           { $1 :: $2                }
;